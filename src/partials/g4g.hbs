<link rel="stylesheet" href="css/g4g.css">

<section class="save-wz-banner py-5">
  <div class="container">
    <div class="row align-items-center">
      
      <div class="col-sm-12 col-md-6 left-banner">
        <img class="g4g-hero-logo" src="{{site.campaigns.giveForGood.heroLogo}}" alt="Give For Good Louisville logo" />
        <div class="save-wz-banner-text mb-4">
          <h3 id="blip-text" class="g4g-left-blip mb-0"></h3>
        </div>
        <div class="megaphone-container anim-floaty mb-3">
          <img src="https://louisvillemakesgames.org/img/savewarpzone-megaphone.png" class="megaphone" />
          <div class="anim-choppy d-inline-block">
            <img src="https://louisvillemakesgames.org/img/savewarpzone-bolt1.png" class="bolt1" />
          </div>
          <div class="anim-choppy d-inline-block">
            <img src="https://louisvillemakesgames.org/img/savewarpzone-bolt1.png" class="bolt2" />
          </div>
        </div>
      </div>

      <div class="banner-right col-sm-12 col-md-6 text-center">
        <a href="{{site.campaigns.giveForGood.donateUrl}}"
           target="_blank" 
           rel="noopener noreferrer"
           class="donate-button">
          <span class="donate-copy">
          <span class="sub">{{site.campaigns.giveForGood.ctaSub}}</span><br/>
          <span class="big">{{site.campaigns.giveForGood.ctaMain}}</span>
          </span>
        </a>

        {{#if site.campaigns.giveForGood.donationMeterEnabled}}
        <div id="g4g-donation-meter"
             class="g4g-donation-meter"
             data-goal-cents="{{site.campaigns.giveForGood.donationGoalCents}}"
             data-endpoint="{{site.campaigns.giveForGood.donationDataUrl}}"
             data-proxy-prefix="{{site.campaigns.giveForGood.donationProxyPrefix}}"
             aria-live="polite">
          <div class="g4g-meter-content">
            <p class="g4g-meter-headline">
              <strong id="g4g-current-amount">--</strong> raised toward
              <strong id="g4g-goal-amount">$10,000</strong>
            </p>
            <div class="g4g-meter-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
              <div id="g4g-meter-fill" class="g4g-meter-fill"></div>
            </div>
            <p id="g4g-meter-meta" class="g4g-meter-meta">Loading live total...</p>
          </div>
          <div id="g4g-meter-loading" class="g4g-meter-loading" aria-hidden="true">Refreshing live total...</div>
        </div>
        {{/if}}

                                       <h2>{{site.campaigns.giveForGood.heroStreamTitle}}</h2>

        <div class="stream-row">
          {{#each site.campaigns.giveForGood.streamLinks}}
          <a href="{{url}}" target="_blank" rel="noopener noreferrer" class="stream-button">
            {{#if icon}}<i class="{{icon}}" aria-hidden="true"></i>{{/if}}
            <span>{{label}}</span>
          </a>
          {{/each}}
        </div>
      </div>
    </div>

    {{> g4g-stream-schedule schedule=g4gStreamSchedule streamLinks=site.campaigns.giveForGood.streamLinks}}
  </div>
</section>

<ul id="g4g-messages" class="d-none" aria-hidden="true">
  {{#each site.campaigns.giveForGood.heroMessages}}
  <li>{{this}}</li>
  {{/each}}
</ul>

  {{#if site.campaigns.giveForGood.showAuction}}
{{> g4g-auction}}
  {{/if}}
<script src="js/g4g.js"></script>